{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  },

  "ConnectionStrings": {
    "DefaultConnection": ""
  },

  "JwtSettings": {
    "Issuer": "EthelPMS",
    "Audience": "EthelPMS",
    "AccessTokenExpirationMinutes": 360,
    "RefreshTokenExpirationDays": 7,
    "SecretKey": ""
  },

  "EmailSettings": {
    "SmtpHost": "",
    "SmtpPort": 587,
    "UseSsl": true,
    "SenderName": "EthelPMS",
    "SenderEmail": "",
    "Username": "",
    "Password": ""
  },

  "MultiTenancy": {
    "Strategy": "Claim",
    "ClaimType": "org_id"
  },

  "Hangfire": {
    "DashboardPath": "/hangfire",
    "WorkerCount": 2
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200", "http://localhost:4201", "http://localhost:8000", "http://localhost:3000", "http://localhost:5173" ]
  },

  "AllowedHosts": "*"
}
