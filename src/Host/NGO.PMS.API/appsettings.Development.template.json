{
  "_comment": "Copy this file to set up dotnet user-secrets. Do NOT commit real values.",
  "_usage": [
    "cd src/Host/NGO.PMS.API",
    "dotnet user-secrets init",
    "dotnet user-secrets set \"ConnectionStrings:DefaultConnection\" \"Host=db.xxx.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=YOUR_PASSWORD;SSL Mode=Require;Trust Server Certificate=true\"",
    "dotnet user-secrets set \"JwtSettings:SecretKey\" \"your-256-bit-secret-key-at-least-32-chars-long\"",
    "dotnet user-secrets set \"EmailSettings:SmtpHost\" \"smtp.gmail.com\"",
    "dotnet user-secrets set \"EmailSettings:SenderEmail\" \"noreply@ethelpms.com\"",
    "dotnet user-secrets set \"EmailSettings:Username\" \"your-email@gmail.com\"",
    "dotnet user-secrets set \"EmailSettings:Password\" \"your-app-password\""
  ],

  "ConnectionStrings": {
    "DefaultConnection": "USE_DOTNET_USER_SECRETS"
  },

  "JwtSettings": {
    "SecretKey": "REPLACE-WITH-A-STRONG-256-BIT-SECRET-KEY-MIN-32-CHARS"
  },

  "EmailSettings": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "UseSsl": true,
    "SenderName": "EthelPMS",
    "SenderEmail": "noreply@ethelpms.com",
    "Username": "your-email@gmail.com",
    "Password": "your-app-password"
  }
}
